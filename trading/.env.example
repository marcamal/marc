# =============================================================================
# ATLAS — environment configuration
# =============================================================================
# 1. Copy this file to ".env"   (Windows:  copy .env.example .env)
# 2. Fill in your Alpaca PAPER keys.
# 3. NEVER commit .env. It is already in .gitignore.
# =============================================================================


# -----------------------------------------------------------------------------
# ALPACA CREDENTIALS
# -----------------------------------------------------------------------------
# Get these from: https://app.alpaca.markets  ->  Home  ->  "API Keys"
# IMPORTANT: make sure the "Paper" / "Live" toggle in the top-left of the
# Alpaca dashboard is set to PAPER before you generate the keys.
# Paper keys and live keys are DIFFERENT keys. ATLAS expects paper keys here.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=


# -----------------------------------------------------------------------------
# TRADING MODE  --  the single most important setting in this file
# -----------------------------------------------------------------------------
# One of: paper | live | backtest | replay
# Anything unrecognised falls back to "paper" (fail closed).
ATLAS_TRADING_MODE=paper

# Live trading requires ALL THREE of the following, independently:
#   1. ATLAS_TRADING_MODE=live
#   2. ATLAS_LIVE_TRADING_ENABLED=true
#   3. ATLAS_MANUAL_LIVE_CONFIRMATION=I_UNDERSTAND_THE_RISK
# Leave these exactly as they are. Do not change them casually.
ATLAS_LIVE_TRADING_ENABLED=false
ATLAS_MANUAL_LIVE_CONFIRMATION=no


# -----------------------------------------------------------------------------
# MARKET DATA
# -----------------------------------------------------------------------------
# Feed for stocks: iex | sip | delayed_sip
#   iex         = free plan. Real-time, but only IEX volume (~2.5% of market).
#   sip         = full market. Requires the paid "Algo Trader Plus" plan.
#   delayed_sip = full market, 15 minutes delayed. Free plan.
# On the FREE plan, requesting "sip" data newer than 15 minutes returns an error.
ATLAS_STOCK_DATA_FEED=iex

# Free plan allows max 30 symbols on one websocket connection.
# Raise this only if you pay for Algo Trader Plus.
ATLAS_MAX_STREAM_SYMBOLS=30

# Set true if you subscribe to Algo Trader Plus. Unlocks sip + unlimited symbols.
ATLAS_HAS_PAID_DATA_PLAN=false


# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# SQLite by default: zero setup, perfect for the MVP.
# To move to PostgreSQL later, just change this line, e.g.:
#   ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
ATLAS_DATABASE_URL=sqlite+aiosqlite:///./data/atlas.db


# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8000
# Comma-separated list of origins allowed to call the API (the frontend).
ATLAS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
ATLAS_LOG_LEVEL=INFO
# "console" is readable while developing, "json" is better for log analysis.
ATLAS_LOG_FORMAT=console


# -----------------------------------------------------------------------------
# AI PROVIDERS  (optional — ATLAS runs fine without these)
# -----------------------------------------------------------------------------
# Used later by the research / mentor agents. Leave empty to disable.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=


# -----------------------------------------------------------------------------
# SEC EDGAR  (optional, for the fundamental / insider research agents)
# -----------------------------------------------------------------------------
# The SEC requires a real contact in the User-Agent header. Name + email.
SEC_USER_AGENT=ATLAS Research your_name your_email@example.com
